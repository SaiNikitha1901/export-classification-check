# Export Classification Check - environment configuration (D4).
# docker compose loads this file first, then .env (if present) overrides it.
# To use a real LLM: cp .env.example .env, then edit .env. Never commit .env.
# Values here are LOCAL-ONLY defaults so a clean clone starts with no setup.

# Host ports are read by docker compose from .env only (defaults shown). Change one if it is busy on your machine.
# API_HOST_PORT=8000  RETRIEVER_HOST_PORT=8001  LLM_STUB_HOST_PORT=8002  GRAFANA_HOST_PORT=3000
# PROMETHEUS_HOST_PORT=9090  JAEGER_HOST_PORT=16686  LOCUST_HOST_PORT=8089

# ---------- shared ----------
POSTGRES_USER=ecs
POSTGRES_PASSWORD=ecs_local_only            # local dev database only; change in .env for anything shared
POSTGRES_DB=ecs
POSTGRES_DSN=postgresql://ecs:ecs_local_only@postgres:5432/ecs
REDIS_URL=redis://redis:6379/0
RETRIEVER_URL=http://retriever:8001
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
LOG_LEVEL=INFO

# ---------- Member 1: API / platform ----------
RATE_LIMIT_PER_MIN=20                       # run submissions per client per rolling minute (cost control)
RUN_CACHE_TTL_S=86400                       # whole-run cache lifetime
RUN_TIMEOUT_S=300                           # hard limit for one run in the worker; watchdog fails runs past this.
# 300 s because free-tier providers rate-limit (Groq: 8k tokens/min), so a real run takes 2-4 min.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_local_only # Grafana login (anonymous viewing is also enabled)
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
COLLECTOR_OTLP_ENABLED=true                 # Jaeger accepts OTLP on 4317

# ---------- Member 2: retrieval ----------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDEX_DIR=/data/index
RETRIEVAL_CACHE_TTL_S=3600
LIVE_SCORING_ENABLED=true                   # live quality scorer in the retriever (L6)
LIVE_SCORING_SAMPLE_RATE=0.1                # share of finished runs scored
LIVE_SCORING_INTERVAL_S=30
EVAL_JUDGE=auto                             # llm | lexical | auto (lexical is used automatically with the stub)
# FORCE_SEARCH_MODE: leave empty; "dense" only for the L3 before/after batch.
# (No inline comment after an empty value: compose would read the comment as the value.)
FORCE_SEARCH_MODE=

# ---------- Member 3: agents / LLM ----------
# Default points at the local stub so the system runs with no account. For a real provider set,
# in .env, any OpenAI-compatible endpoint, e.g. LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=http://llm-stub:8002/v1
LLM_API_KEY=stub-not-a-secret
LLM_MODEL=stub
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=3                           # retries on timeouts / 5xx / connection errors
LLM_RATE_LIMIT_MAX_WAIT_S=60                # on HTTP 429, wait the provider's Retry-After if it is at most this long
LLM_RATE_LIMIT_MAX_WAITS=30                 # max 429 waits per call; longer hints count as failures (fallback)
LLM_PRICE_IN_PER_1K=0.00059                 # notional price, used for cost reporting even on a free tier
LLM_PRICE_OUT_PER_1K=0.00079
AGENT_MAX_STEPS=20                          # one verified run uses ~8 LLM + ~8 tool calls; room for one verifier retry
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_WALL_S=240                        # agent wall-clock budget, kept below RUN_TIMEOUT_S
CLASSIFIER_MAX_TURNS=10                     # LLM turns per classifier attempt
PROMPT_VERSION=classifier@v1
CB_FAILURE_THRESHOLD=5                      # circuit breaker: failures within CB_WINDOW_S that open it
CB_WINDOW_S=60
CB_OPEN_S=30                                # seconds open before a half-open probe
# LLM_FORCE_FAIL: demo switch, all | primary | fallback. Leave empty for normal operation.
LLM_FORCE_FAIL=
TOXICITY_THRESHOLD=0.7
STUB_DELAY_MIN_S=1.5                        # llm-stub latency range (D6 load tests)
STUB_DELAY_MAX_S=4.0
